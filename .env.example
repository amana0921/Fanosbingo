# Copy to .env and fill in. .env is gitignored.
#
# VITE_* variables are COMPILE-TIME: they are baked into the published bundle and
# are readable by anyone who loads the app. Nothing secret belongs here.

# This project's own API, not a supabase.co host. The URL shape is preserved
# (/rest/v1, /realtime/v1, /functions/v1) so supabase-js works against it
# unchanged.
VITE_SUPABASE_URL=https://api.yisakmesifin.org
VITE_API_BASE_URL=https://api.yisakmesifin.org

# A JWT with role=anon, signed with the same secret PostgREST verifies with.
# Public by design: it grants only what RLS allows anonymous users to see.
#
#   node scripts/mint-anon-key.mjs dev
VITE_SUPABASE_ANON_KEY=

# WalletConnect / Reown project id, for the wallet login path.
VITE_REOWN_PROJECT_ID=

# Which BSC chain this build talks to. 97 = testnet, 56 = mainnet.
#
# The deploy workflow reads this from /fanosbingo-<env>/bsc/chain_id -- the same
# SSM parameter Terraform writes and the functions service verifies against the
# RPC at boot -- so the app, the backend and the infrastructure cannot disagree.
#
# src/lib/walletConfig.ts used to hardcode viem's `bsc` (56, MAINNET) in every
# build, including dev where everything server-side is testnet. Set it here for
# local runs; leave it unset and the app defaults to testnet, which is the safe
# direction to fail.
VITE_BSC_CHAIN_ID=97

# The deployed deposit contract. Read by the deploy workflow from
# /fanosbingo-<env>/bsc/deposit_contract_address, which scripts/deploy-contract.mjs
# writes when it deploys.
#
# Empty is legitimate and means "no contract yet" -- the deposit modal then says
# deposits are unavailable rather than showing a form with nowhere to send funds.
#
# DEPLOYING THE CONTRACT THEREFORE REQUIRES A caddy REDEPLOY to take effect, the
# same as the anon key. The address is baked into the bundle.
VITE_DEPOSIT_CONTRACT_ADDRESS=
