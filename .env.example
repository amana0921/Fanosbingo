# Copy to .env and fill in. .env is gitignored.
#
# VITE_* variables are COMPILE-TIME: they are baked into the published bundle and
# are readable by anyone who loads the app. Nothing secret belongs here.

# This project's own API, not a supabase.co host. The URL shape is preserved
# (/rest/v1, /realtime/v1, /functions/v1) so supabase-js works against it
# unchanged.
VITE_SUPABASE_URL=https://api.yisakmesifin.org
VITE_API_BASE_URL=https://api.yisakmesifin.org

# A JWT with role=anon, signed with the same secret PostgREST verifies with.
# Public by design: it grants only what RLS allows anonymous users to see.
#
#   node scripts/mint-anon-key.mjs dev
VITE_SUPABASE_ANON_KEY=

# WalletConnect / Reown project id, for the wallet login path.
VITE_REOWN_PROJECT_ID=
